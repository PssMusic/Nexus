    <!-- Toast Container -->
    <div id="toast-container" class="fixed bottom-4 right-4 z-[120] flex flex-col gap-2 pointer-events-none"></div>

    <script>
        // --- DATA & STATE ---
        const STORAGE_KEY = 'nexus_links_data';
        
        let state = {
            links: [],
            categories: [
                { id: 'cat-all', name: 'Todos', color: '#64748b', isDefault: true },
                { id: 'cat-work', name: 'Trabajo', color: '#3b82f6', isDefault: false },
                { id: 'cat-design', name: 'Diseño', color: '#ec4899', isDefault: false },
                { id: 'cat-dev', name: 'Desarrollo', color: '#10b981', isDefault: false }
            ],
            settings: {
                viewMode: 'cards', // cards, compact, buttons
                theme: 'dark', // dark, light
            },
            currentCategory: 'cat-all',
            searchQuery: ''
        };

        const THEME_COLORS = ['#3b82f6', '#ec4899', '#10b981', '#f59e0b', '#8b5cf6', '#ef4444', '#14b8a6', '#64748b'];
        
        // PWA Setup Variables
        let deferredPrompt;

        // --- INITIALIZATION ---
        document.addEventListener('DOMContentLoaded', () => {
            loadData();
            setupPWA();
            initUI();
            renderCategories();
            setViewMode(state.settings.viewMode, false);
            applyTheme(state.settings.theme);
            renderLinks();
            setupEventListeners();
        });

        function loadData() {
            const data = localStorage.getItem(STORAGE_KEY);
            if (data) {
                try {
                    const parsed = JSON.parse(data);
                    state.links = parsed.links || [];
                    if (parsed.categories && parsed.categories.length > 0) {
                        state.categories = parsed.categories;
                    }
                    if (parsed.settings) state.settings = { ...state.settings, ...parsed.settings };
                } catch (e) {
                    showToast('Error cargando datos locales', 'error');
                }
            }
        }

        function saveData() {
            localStorage.setItem(STORAGE_KEY, JSON.stringify({
                links: state.links,
                categories: state.categories,
                settings: state.settings
            }));
            renderCategories(); // Update counts
        }

        function exportData() {
            const dataStr = JSON.stringify({ links: state.links, categories: state.categories });
            const dataBlob = new Blob([dataStr], { type: 'application/json' });
            const url = URL.createObjectURL(dataBlob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `Nexus_Backup_${new Date().toISOString().split('T')[0]}.json`;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
            showToast('Datos exportados correctamente', 'success');
        }

        function importData(event) {
            const file = event.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = (e) => {
                try {
                    const parsed = JSON.parse(e.target.result);
                    if (parsed.links && Array.isArray(parsed.links)) {
                        state.links = parsed.links;
                        if (parsed.categories) state.categories = parsed.categories;
                        saveData();
                        renderCategories();
                        renderLinks();
                        showToast('Datos restaurados correctamente', 'success');
                    } else {
                        throw new Error("Formato inválido");
                    }
                } catch (error) {
                    showToast('El archivo JSON no es válido', 'error');
                }
                event.target.value = ''; // Reset input
            };
            reader.readAsText(file);
        }

        function setupPWA() {
            // 1. Generate Manifest
            const manifest = {
                name: "Nexus Link Manager",
                short_name: "Nexus",
                description: "Gestor inteligente de enlaces y marcadores",
                start_url: "./",
                display: "standalone",
                background_color: "#0f172a",
                theme_color: "#3b82f6",
                icons: [
                    {
                        // Using a generated SVG data URI for icon to keep it single-file
                        src: "data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCA1MTIgNTEyIj48cmVjdCB3aWR0aD0iNTEyIiBoZWlnaHQ9IjUxMiIgZmlsbD0iIzBiMTcyYSIvPjxjaXJjbGUgY3g9IjI1NiIgY3k9IjI1NiIgcj0iMTUwIiBmaWxsPSIjM2I4MmY2Ii8+PC9zdmc+",
                        sizes: "512x512",
                        type: "image/svg+xml"
                    }
                ]
            };
            
            const manifestBlob = new Blob([JSON.stringify(manifest)], { type: 'application/json' });
            const manifestUrl = URL.createObjectURL(manifestBlob);
            document.getElementById('pwa-manifest').setAttribute('href', manifestUrl);

            // 2. Generate Service Worker
            const swCode = `
                const CACHE_NAME = 'nexus-v1';
                self.addEventListener('install', (e) => {
                    e.waitUntil(caches.open(CACHE_NAME).then((cache) => cache.addAll(['./'])));
                    self.skipWaiting();
                });
                self.addEventListener('activate', (e) => { e.waitUntil(self.clients.claim()); });
                self.addEventListener('fetch', (e) => {
                    e.respondWith(
                        caches.match(e.request).then((response) => response || fetch(e.request).catch(() => caches.match('./')))
                    );
                });
            `;
            const swBlob = new Blob([swCode], { type: 'application/javascript' });
            const swUrl = URL.createObjectURL(swBlob);

            if ('serviceWorker' in navigator) {
                navigator.serviceWorker.register(swUrl).then(() => console.log('SW Registrado')).catch(console.error);
            }

            // 3. Install Prompt Logic
            window.addEventListener('beforeinstallprompt', (e) => {
                e.preventDefault();
                deferredPrompt = e;
                const installBtn = document.getElementById('install-btn');
                installBtn.classList.remove('hidden');
                installBtn.classList.add('flex');
                
                installBtn.addEventListener('click', async () => {
                    if (deferredPrompt) {
                        deferredPrompt.prompt();
                        const { outcome } = await deferredPrompt.userChoice;
                        if (outcome === 'accepted') {
                            installBtn.classList.add('hidden');
                            installBtn.classList.remove('flex');
                        }
                        deferredPrompt = null;
                    }
                });
            });
        }

        function initUI() {
            // Setup Color Picker for Categories
            const colorPicker = document.getElementById('color-picker');
            THEME_COLORS.forEach(color => {
                const btn = document.createElement('button');
                btn.className = `w-8 h-8 rounded-full cursor-pointer transition-transform hover:scale-110 focus:outline-none ring-2 ring-transparent`;
                btn.style.backgroundColor = color;
                btn.onclick = (e) => {
                    e.preventDefault();
                    document.getElementById('cat-color').value = color;
                    Array.from(colorPicker.children).forEach(c => c.classList.remove('ring-slate-400', 'dark:ring-white', 'scale-110'));
                    btn.classList.add('ring-slate-400', 'dark:ring-white', 'scale-110');
                };
                colorPicker.appendChild(btn);
            });
            colorPicker.children[0].click(); // Select first by default
        }

        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            const overlay = document.getElementById('sidebar-overlay');
            sidebar.classList.toggle('open');
            overlay.classList.toggle('open');
        }

        function toggleTheme() {
            const newTheme = state.settings.theme === 'dark' ? 'light' : 'dark';
            applyTheme(newTheme);
            state.settings.theme = newTheme;
            saveData();
        }

        function applyTheme(theme) {
            const html = document.documentElement;
            const btn = document.getElementById('theme-toggle-btn');
            if (theme === 'dark') {
                html.classList.add('dark');
                btn.innerHTML = '<i class="ph ph-sun text-lg"></i>';
            } else {
                html.classList.remove('dark');
                btn.innerHTML = '<i class="ph ph-moon text-lg"></i>';
            }
        }

        function setViewMode(mode, save = true) {
            const container = document.getElementById('links-container');
            const btns = ['cards', 'compact', 'buttons'].map(m => document.getElementById(`view-${m}`));
            
            btns.forEach(b => {
                b.classList.remove('bg-white', 'dark:bg-slate-700', 'shadow-sm');
            });
            document.getElementById(`view-${mode}`).classList.add('bg-white', 'dark:bg-slate-700', 'shadow-sm');

            // Set Container Classes based on mode
            container.className = 'view-transition-group w-full';
            if (mode === 'cards') {
                container.classList.add('grid', 'grid-cols-1', 'sm:grid-cols-2', 'lg:grid-cols-3', 'xl:grid-cols-4', 'gap-4');
            } else if (mode === 'compact') {
                container.classList.add('flex', 'flex-col', 'gap-2');
            } else if (mode === 'buttons') {
                container.classList.add('flex', 'flex-wrap', 'gap-3');
            }

            state.settings.viewMode = mode;
            if (save) saveData();
            renderLinks();
        }

        // Modal Functions
        function openModal(id) {
            const modal = document.getElementById(id);
            const content = document.getElementById(`${id}-content`);
            const backdrop = document.getElementById(`${id}-backdrop`);
            
            if (id === 'link-modal') resetLinkModal();

            modal.classList.remove('hidden');
            // Trigger animation
            setTimeout(() => {
                backdrop.classList.remove('opacity-0');
                content.classList.remove('opacity-0', 'scale-95');
            }, 10);
        }

        function closeModal(id) {
            const modal = document.getElementById(id);
            const content = document.getElementById(`${id}-content`);
            const backdrop = document.getElementById(`${id}-backdrop`);
            
            backdrop.classList.add('opacity-0');
            content.classList.add('opacity-0', 'scale-95');
            
            setTimeout(() => {
                modal.classList.add('hidden');
            }, 300);
        }

        let confirmCallback = null;
        function openConfirm(title, msg, callback) {
            document.getElementById('confirm-title').innerText = title;
            document.getElementById('confirm-msg').innerText = msg;
            confirmCallback = callback;
            
            const modal = document.getElementById('confirm-modal');
            const content = document.getElementById('confirm-modal-content');
            const backdrop = document.getElementById('confirm-modal-backdrop');
            
            modal.classList.remove('hidden');
            setTimeout(() => {
                backdrop.classList.remove('opacity-0');
                content.classList.remove('opacity-0', 'scale-95');
            }, 10);

            document.getElementById('confirm-btn').onclick = () => {
                if(confirmCallback) confirmCallback();
                closeConfirmModal();
            };
        }

        function closeConfirmModal() {
            const modal = document.getElementById('confirm-modal');
            const content = document.getElementById('confirm-modal-content');
            const backdrop = document.getElementById('confirm-modal-backdrop');
            
            backdrop.classList.add('opacity-0');
            content.classList.add('opacity-0', 'scale-95');
            setTimeout(() => modal.classList.add('hidden'), 300);
        }

        function showToast(msg, type = 'info') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            
            const colors = type === 'success' ? 'bg-emerald-50 text-emerald-600 border-emerald-200 dark:bg-emerald-900/30 dark:border-emerald-800' :
                           type === 'error' ? 'bg-red-50 text-red-600 border-red-200 dark:bg-red-900/30 dark:border-red-800' :
                           'bg-white text-slate-700 border-slate-200 dark:bg-slate-800 dark:text-slate-200 dark:border-slate-700';
            
            const icon = type === 'success' ? 'ph-check-circle' : type === 'error' ? 'ph-x-circle' : 'ph-info';

            toast.className = `flex items-center gap-3 px-4 py-3 rounded-xl border shadow-lg transform transition-all duration-300 translate-y-10 opacity-0 ${colors}`;
            toast.innerHTML = `<i class="ph ${icon} text-xl"></i> <span class="text-sm font-medium">${msg}</span>`;
            
            container.appendChild(toast);
            
            // Animate in
            requestAnimationFrame(() => {
                toast.classList.remove('translate-y-10', 'opacity-0');
            });

            // Remove after 3s
            setTimeout(() => {
                toast.classList.add('opacity-0', 'scale-95');
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }

        function renderCategories() {
            const container = document.getElementById('categories-container');
            const select = document.getElementById('link-category');
            container.innerHTML = '';
            select.innerHTML = '';

            // Update Global Stats
            document.getElementById('stat-total').innerText = state.links.length;
            document.getElementById('stat-favs').innerText = state.links.filter(l => l.favorite).length;

            state.categories.forEach(cat => {
                const count = cat.id === 'cat-all' ? state.links.length : state.links.filter(l => l.categoryId === cat.id).length;
                const isSelected = state.currentCategory === cat.id;
                
                // Sidebar item
                const div = document.createElement('div');
                div.className = `group flex items-center justify-between px-3 py-2 rounded-xl cursor-pointer transition-colors ${isSelected ? 'bg-slate-200/50 dark:bg-slate-800' : 'hover:bg-slate-100 dark:hover:bg-slate-800/50'}`;
                div.onclick = () => selectCategory(cat.id, cat.name);
                
                let actionHtml = '';
                if (!cat.isDefault) {
                    actionHtml = `
                        <button onclick="event.stopPropagation(); deleteCategory('${cat.id}')" class="opacity-0 group-hover:opacity-100 p-1 text-slate-400 hover:text-red-500 transition-all">
                            <i class="ph ph-trash"></i>
                        </button>
                    `;
                }

                div.innerHTML = `
                    <div class="flex items-center gap-3">
                        <div class="w-3 h-3 rounded-full" style="background-color: ${cat.color}"></div>
                        <span class="text-sm font-medium ${isSelected ? 'text-slate-900 dark:text-white' : 'text-slate-600 dark:text-slate-300'}">${cat.name}</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="text-xs bg-slate-200 dark:bg-slate-700 px-2 py-0.5 rounded-full text-slate-500 dark:text-slate-400">${count}</span>
                        ${actionHtml}
                    </div>
                `;
                container.appendChild(div);

                // Add to Select dropdown (skip 'cat-all')
                if (cat.id !== 'cat-all') {
                    const option = document.createElement('option');
                    option.value = cat.id;
                    option.textContent = cat.name;
                    select.appendChild(option);
                }
            });
        }

        function selectCategory(id, name) {
            state.currentCategory = id;
            document.getElementById('current-category-title').innerText = name;
            renderCategories();
            renderLinks();
            if(window.innerWidth <= 768) toggleSidebar(); // auto close on mobile
        }

        function saveCategory() {
            const name = document.getElementById('cat-name').value.trim();
            const color = document.getElementById('cat-color').value;
            if (!name) return showToast('El nombre es obligatorio', 'error');

            const newCat = {
                id: 'cat-' + Date.now(),
                name,
                color,
                isDefault: false
            };
            state.categories.push(newCat);
            saveData();
            renderCategories();
            closeModal('category-modal');
            document.getElementById('cat-name').value = '';
            showToast('Categoría creada', 'success');
        }

        function deleteCategory(id) {
            openConfirm('Eliminar Categoría', 'Los enlaces de esta categoría se moverán a "Todos".', () => {
                state.categories = state.categories.filter(c => c.id !== id);
                // Reassign links
                state.links.forEach(l => {
                    if(l.categoryId === id) l.categoryId = state.categories[1].id; // Assign to first custom cat
                });
                if(state.currentCategory === id) selectCategory('cat-all', 'Todos');
                saveData();
                renderCategories();
                renderLinks();
                showToast('Categoría eliminada', 'success');
            });
        }

        function generateId() { return Math.random().toString(36).substr(2, 9); }

        function getDomain(url) {
            try { return new URL(url).hostname.replace('www.', ''); } 
            catch (e) { return url; }
        }

        function formatTitleFallback(domain) {
            const parts = domain.split('.');
            if(parts.length > 0) {
                return parts[0].charAt(0).toUpperCase() + parts[0].slice(1);
            }
            return domain;
        }

        async function pasteFromClipboard() {
            try {
                const text = await navigator.clipboard.readText();
                if (text && (text.startsWith('http://') || text.startsWith('https://'))) {
                    document.getElementById('link-url').value = text;
                    autoExtractData();
                    showToast('Enlace pegado', 'success');
                } else {
                    showToast('No hay una URL válida en el portapapeles', 'error');
                }
            } catch (err) {
                showToast('Permiso de portapapeles denegado', 'error');
            }
        }

        function autoExtractData() {
            const urlInput = document.getElementById('link-url').value;
            if (!urlInput) return;
            
            let finalUrl = urlInput;
            if(!finalUrl.startsWith('http')) finalUrl = 'https://' + finalUrl;
            document.getElementById('link-url').value = finalUrl;

            const domain = getDomain(finalUrl);
            const titleInput = document.getElementById('link-title');
            if (!titleInput.value) {
                titleInput.value = formatTitleFallback(domain);
            }
        }

        function resetLinkModal() {
            document.getElementById('link-id').value = '';
            document.getElementById('link-url').value = '';
            document.getElementById('link-title').value = '';
            document.getElementById('link-fav').checked = false;
            updateFavToggleUI();
            
            // Try to paste automatically
            if(navigator.clipboard && navigator.clipboard.readText) {
                navigator.clipboard.readText().then(text => {
                    if (text && (text.startsWith('http://') || text.startsWith('https://'))) {
                        document.getElementById('link-url').value = text;
                        autoExtractData();
                    }
                }).catch(e => {}); // Ignore errors silently here
            }
        }

        function updateFavToggleUI() {
            const isFav = document.getElementById('link-fav').checked;
            const bg = document.getElementById('fav-toggle-bg');
            const dot = document.getElementById('fav-toggle-dot');
            if (isFav) {
                bg.classList.replace('bg-slate-200', 'bg-amber-500');
                bg.classList.replace('dark:bg-slate-700', 'dark:bg-amber-500');
                dot.classList.add('translate-x-4');
            } else {
                bg.classList.replace('bg-amber-500', 'bg-slate-200');
                bg.classList.replace('dark:bg-amber-500', 'dark:bg-slate-700');
                dot.classList.remove('translate-x-4');
            }
        }

        // Event listener for custom toggle
        document.getElementById('link-fav').addEventListener('change', updateFavToggleUI);

        function saveLink() {
            const id = document.getElementById('link-id').value;
            let url = document.getElementById('link-url').value.trim();
            const title = document.getElementById('link-title').value.trim();
            const categoryId = document.getElementById('link-category').value;
            const isFav = document.getElementById('link-fav').checked;

            if (!url) return showToast('La URL es obligatoria', 'error');
            if (!url.startsWith('http')) url = 'https://' + url;

            const domain = getDomain(url);
            const finalTitle = title || formatTitleFallback(domain);
            const favicon = `https://www.google.com/s2/favicons?domain=${domain}&sz=64`;

            const linkObj = {
                id: id || generateId(),
                url,
                title: finalTitle,
                domain,
                favicon,
                categoryId,
                favorite: isFav,
                createdAt: id ? state.links.find(l => l.id === id).createdAt : Date.now()
            };

            if (id) {
                state.links = state.links.map(l => l.id === id ? linkObj : l);
                showToast('Enlace actualizado', 'success');
            } else {
                // Check duplicate
                if(state.links.some(l => l.url === url)) {
                    showToast('Este enlace ya existe', 'info');
                } else {
                    state.links.unshift(linkObj);
                    showToast('Enlace guardado', 'success');
                }
            }

            saveData();
            closeModal('link-modal');
            renderLinks();
        }

        function editLink(id) {
            const link = state.links.find(l => l.id === id);
            if(!link) return;

            document.getElementById('link-modal-title').innerText = 'Editar Enlace';
            document.getElementById('link-id').value = link.id;
            document.getElementById('link-url').value = link.url;
            document.getElementById('link-title').value = link.title;
            document.getElementById('link-category').value = link.categoryId;
            document.getElementById('link-fav').checked = link.favorite;
            updateFavToggleUI();
            
            openModal('link-modal');
        }

        function deleteLink(id) {
            openConfirm('Eliminar Enlace', '¿Seguro que deseas eliminar este enlace?', () => {
                state.links = state.links.filter(l => l.id !== id);
                saveData();
                renderLinks();
                showToast('Enlace eliminado', 'success');
            });
        }

        function toggleFavorite(id, event) {
            event.stopPropagation();
            const link = state.links.find(l => l.id === id);
            if(link) {
                link.favorite = !link.favorite;
                saveData();
                renderLinks();
                showToast(link.favorite ? 'Añadido a favoritos' : 'Removido de favoritos', 'info');
            }
        }

        function renderLinks() {
            const container = document.getElementById('links-container');
            const emptyState = document.getElementById('empty-state');
            container.innerHTML = '';

            let filtered = state.links;

            // 1. Filter by Category
            if (state.currentCategory !== 'cat-all') {
                filtered = filtered.filter(l => l.categoryId === state.currentCategory);
            }

            // 2. Filter by Search
            if (state.searchQuery) {
                const q = state.searchQuery.toLowerCase();
                filtered = filtered.filter(l => 
                    l.title.toLowerCase().includes(q) || 
                    l.domain.toLowerCase().includes(q) ||
                    l.url.toLowerCase().includes(q)
                );
            }

            // 3. Sort
            const sortVal = document.getElementById('sort-select').value;
            if (sortVal === 'recent') filtered.sort((a, b) => b.createdAt - a.createdAt);
            if (sortVal === 'az') filtered.sort((a, b) => a.title.localeCompare(b.title));
            if (sortVal === 'za') filtered.sort((a, b) => b.title.localeCompare(a.title));
            if (sortVal === 'fav') filtered.sort((a, b) => (b.favorite === a.favorite) ? 0 : b.favorite ? 1 : -1);

            // Empty state handling
            if (filtered.length === 0) {
                container.classList.add('hidden');
                emptyState.classList.remove('hidden');
                setTimeout(() => emptyState.classList.remove('opacity-0'), 10);
                return;
            } else {
                emptyState.classList.add('hidden', 'opacity-0');
                container.classList.remove('hidden');
            }

            // Render based on View Mode
            filtered.forEach((link, index) => {
                const catColor = state.categories.find(c => c.id === link.categoryId)?.color || '#64748b';
                const el = document.createElement('div');
                
                // Animation delay for staggered load
                el.style.animationDelay = `${index * 0.05}s`;
                el.className = `animate-slide-up bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl transition-all duration-300 hover:shadow-lg hover:-translate-y-1 group relative overflow-hidden`;

                if (state.settings.viewMode === 'cards') {
                    el.className += ' flex flex-col h-44';
                    el.innerHTML = `
                        <div class="h-1 w-full" style="background-color: ${catColor}"></div>
                        <div class="p-5 flex-1 flex flex-col relative z-10 cursor-pointer" onclick="window.open('${link.url}', '_blank')">
                            <div class="flex justify-between items-start mb-3">
                                <img src="${link.favicon}" alt="" class="w-10 h-10 rounded-lg bg-slate-100 dark:bg-slate-900 p-1 object-contain" onerror="this.src='data:image/svg+xml;base64,'">
                                <button onclick="toggleFavorite('${link.id}', event)" class="p-2 text-xl rounded-full hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors">
                                    <i class="${link.favorite ? 'ph-fill text-amber-500' : 'ph text-slate-400'} ph-star"></i>
                                </button>
                            </div>
                            <h3 class="font-bold text-lg truncate mb-1 text-slate-800 dark:text-white">${link.title}</h3>
                            <p class="text-sm text-slate-500 dark:text-slate-400 truncate">${link.domain}</p>
                        </div>
                        
                        <!-- Hover Actions -->
                        <div class="absolute inset-x-0 bottom-0 bg-slate-50/90 dark:bg-slate-900/90 backdrop-blur border-t border-slate-200 dark:border-slate-700 p-2 flex justify-end gap-1 translate-y-full group-hover:translate-y-0 transition-transform duration-300 z-20">
                            <button onclick="editLink('${link.id}')" class="p-2 rounded-lg text-slate-600 dark:text-slate-300 hover:bg-brand-100 hover:text-brand-600 dark:hover:bg-brand-900/30 transition-colors" title="Editar"><i class="ph ph-pencil-simple text-lg"></i></button>
                            <button onclick="deleteLink('${link.id}')" class="p-2 rounded-lg text-slate-600 dark:text-slate-300 hover:bg-red-100 hover:text-red-600 dark:hover:bg-red-900/30 transition-colors" title="Eliminar"><i class="ph ph-trash text-lg"></i></button>
                        </div>
                    `;
                } 
                else if (state.settings.viewMode === 'compact') {
                    el.className += ' flex items-center p-3 gap-4 cursor-pointer';
                    el.onclick = (e) => { if(!e.target.closest('button')) window.open(link.url, '_blank'); };
                    el.innerHTML = `
                        <div class="w-1 h-8 rounded-full" style="background-color: ${catColor}"></div>
                        <img src="${link.favicon}" alt="" class="w-8 h-8 rounded-md bg-slate-100 dark:bg-slate-900 object-contain p-0.5">
                        <div class="flex-1 min-w-0">
                            <h3 class="font-semibold text-sm truncate text-slate-800 dark:text-white">${link.title}</h3>
                            <p class="text-xs text-slate-500 dark:text-slate-400 truncate">${link.domain}</p>
                        </div>
                        <div class="flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
                            <button onclick="toggleFavorite('${link.id}', event)" class="p-1.5 text-lg rounded-md hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors">
                                <i class="${link.favorite ? 'ph-fill text-amber-500' : 'ph text-slate-400'} ph-star"></i>
                            </button>
                            <button onclick="editLink('${link.id}')" class="p-1.5 text-lg rounded-md text-slate-500 hover:bg-brand-100 hover:text-brand-600 transition-colors"><i class="ph ph-pencil-simple"></i></button>
                            <button onclick="deleteLink('${link.id}')" class="p-1.5 text-lg rounded-md text-slate-500 hover:bg-red-100 hover:text-red-600 transition-colors"><i class="ph ph-trash"></i></button>
                        </div>
                    `;
                }
                else if (state.settings.viewMode === 'buttons') {
                    el.className = `animate-slide-up inline-flex items-center gap-2 p-2 pr-4 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-full hover:border-brand-500 transition-colors shadow-sm cursor-pointer group`;
                    el.onclick = (e) => { if(!e.target.closest('button')) window.open(link.url, '_blank'); };
                    el.innerHTML = `
                        <img src="${link.favicon}" alt="" class="w-6 h-6 rounded-full bg-slate-100 object-contain">
                        <span class="text-sm font-medium whitespace-nowrap text-slate-800 dark:text-white">${link.title}</span>
                        <div class="flex gap-1 ml-2 hidden group-hover:flex">
                             <button onclick="editLink('${link.id}')" class="text-slate-400 hover:text-brand-500"><i class="ph ph-pencil-simple"></i></button>
                        </div>
                    `;
                }

                container.appendChild(el);
            });
        }

        function setupEventListeners() {
            const searchInput = document.getElementById('search-input');
            
            // Debounced Search
            let timeout = null;
            searchInput.addEventListener('input', (e) => {
                clearTimeout(timeout);
                timeout = setTimeout(() => {
                    state.searchQuery = e.target.value;
                    renderLinks();
                }, 300);
            });

            // Close modals on escape
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape') {
                    closeModal('link-modal');
                    closeModal('category-modal');
                    closeConfirmModal();
                }
            });
        }
    </script>
</body>
</html>
